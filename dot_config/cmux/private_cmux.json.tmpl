{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // The cmux settings that differ from the defaults. A setting in this file wins over its value in cmux Settings,
  // and a change in Settings is written here, so `chezmoi diff` shows it: copy it into this template.
  // `cmux config get <key>` shows where each value comes from, and `cmux config validate` checks this file.
  // Terminal behavior (font, theme, pane keys) stays in ~/.config/ghostty/config, which cmux also reads.
  "app": {
    // the workspace title bar hides and its controls move into the sidebar
    "minimalMode": true,
    "confirmQuit": "never",
    "accentColor": "{{ .cozycabin.orange }}"
  },

  // the divider between panes in a split workspace: the palette's border color, so terminal splits match nvim's window
  // separators (2026-10-21). Ghostty's split-divider-color covers only Ghostty's own splits, which cmux does not draw.
  "paneBorderColor": "{{ .cozycabin.bg4 }}",

  "integrations": {
    "claudeCode": {
      "customClaudePath": "{{ .chezmoi.homeDir }}/.local/bin/claude"
    }
  },

  // In a terminal, pane focus (ctrl+hjkl) and resize (ctrl+shift+hjkl) are Ghostty keybinds, so that
  // smart-splits-backend-ghostty can hand them to nvim; a cmux shortcut would take the key first. ctrl+opt+shift+hjkl
  // move the tab to the pane in that direction, ctrl+opt+jk select workspaces (herdr's agent chord, so herdr inside
  // cmux loses it), and ctrl+opt+cmd+jk move them. Each binding replaces its cmux default: opt+cmd+shift+arrows,
  // ctrl+cmd+[ ], and ctrl+opt+cmd+[ ].
  "shortcuts": {
    "bindings": {
      "moveSurfaceToPaneLeft": "ctrl+opt+shift+h",
      "moveSurfaceToPaneDown": "ctrl+opt+shift+j",
      "moveSurfaceToPaneUp": "ctrl+opt+shift+k",
      "moveSurfaceToPaneRight": "ctrl+opt+shift+l",

      "nextSidebarTab": "ctrl+opt+j",
      "prevSidebarTab": "ctrl+opt+k",
      "moveWorkspaceDown": "cmd+opt+ctrl+j",
      "moveWorkspaceUp": "cmd+opt+ctrl+k"
    },
    "when": {
      // the cmux default ctrl+shift+hjkl resizes browser and markdown panes; Ghostty resizes terminals
      "resize-pane-left": "!terminalFocus",
      "resize-pane-down": "!terminalFocus",
      "resize-pane-up": "!terminalFocus",
      "resize-pane-right": "!terminalFocus",
      // like kitty's `--when-focus-on var:IS_NVIM`: a full-screen app (nvim, less, lazygit) gets the tab-move keys
      "moveSurfaceToPaneLeft": "!terminalAlternateScreen",
      "moveSurfaceToPaneDown": "!terminalAlternateScreen",
      "moveSurfaceToPaneUp": "!terminalAlternateScreen",
      "moveSurfaceToPaneRight": "!terminalAlternateScreen"
    }
  }
}
