+        let loadedBuild = performance
+          .getEntriesByType('navigation')[0]
+          ?.serverTiming?.find((entry) => entry.name === 'build')?.description
+        const connect = () => {
+          const socket = new WebSocket('${wsUrl}/?build')
+          socket.addEventListener('message', ({ data }) => {
+            if (/^[0-9a-f-]{36}$/.test(data)) loadedBuild ??= data
+            // reload(true) ensures resources like images and scripts are fetched again in firefox
+            if (data !== loadedBuild) document.location.reload(true)
+          })
