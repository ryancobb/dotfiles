#!/usr/bin/env bash
# Open a daily plan from the work vault in the current terminal pane, as the
# local Quartz site renders it (in cmux, as a browser tab in the same pane).
# Starts the Quartz server first when it is not running, and `mr-diff --watch`,
# which fetches the MR diffs that the site draws under the MR working docs.
# With no date, opens today's plan, or the newest plan when "plan" has not
# written today's yet. "Today" is the planner's day, in America/Los_Angeles.
#
#   daily               today's plan in this pane (a browser tab in cmux)
#   daily 2026-10-06    that day's plan
#   daily --url         print the URL only
#   daily --restart     restart the Quartz server (after a config or style edit)
#   daily --restart --if-running
#                       the same, but do nothing when the server is down
#   daily --open PATH   a page instead of a plan: a path under the vault, with
#                       an optional #fragment (vault-find uses it)
set -euo pipefail

vault="${PLANNER_VAULT:-$HOME/Projects/vaults/work}"
vault=${vault%/}
quartz="$HOME/.local/share/quartz"
patch="$HOME/.config/quartz-vault/quartz.patch"
tokens="$HOME/.config/quartz-vault/_cozycabin.scss"
port=8080
log="$HOME/.local/state/quartz-vault.log"

usage() {
  echo "usage: daily [--url] [--restart [--if-running]] [--open PATH] [YYYY-MM-DD]" >&2
  exit 2
}

print_only=false
restart=false
if_running=false
day=$(TZ=America/Los_Angeles date +%F)
asked_day=false
page=""
fragment=""
while (($#)); do
  case "$1" in
    --url) print_only=true ;;
    --restart) restart=true ;;
    --if-running) if_running=true ;;
    --open)
      shift
      page=${1:-}
      [[ -n $page ]] || usage
      ;;
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) day=$1 asked_day=true ;;
    *) usage ;;
  esac
  shift
done
if $if_running && ! $restart; then usage; fi
if [[ -n $page ]] && $asked_day; then usage; fi

# A port probe, not a request: the server holds every request until a rebuild
# ends, which can take longer than a request timeout.
server_up() {
  nc -z 127.0.0.1 "$port" 2>/dev/null
}

# A server that started before the localhost patch listens on all interfaces
# (lsof shows *:port), so it runs again on the patched code.
pids=$(pgrep -f "quartz build --serve" | paste -sd, - || true)
if [[ -n $pids ]] && lsof -nP -a -p "$pids" -iTCP -sTCP:LISTEN 2>/dev/null | grep -Eq 'TCP (\*|\[::\]):'; then
  echo "daily: the Quartz server listens on all interfaces; restarting it" >&2
  restart=true
fi

if $if_running && ! server_up; then
  echo "daily: the Quartz server is not running; nothing to restart" >&2
  exit 0
fi

if $restart; then
  echo "daily: restarting the Quartz server" >&2
  pkill -f "quartz build --serve" || true
  for _ in $(seq 1 20); do server_up || break; sleep 0.25; done
fi

if ! server_up; then
  # Upstream Quartz listens on all interfaces, which shares the vault with the
  # network; setup.sh applies quartz.patch, which binds it to 127.0.0.1.
  if ! git -C "$quartz" apply --reverse --check "$patch" 2>/dev/null; then
    echo "daily: Quartz is missing quartz.patch; run ~/.config/quartz-vault/setup.sh" >&2
    exit 1
  fi
  if grep -q 'cdn\.jsdelivr\.net' "$quartz/node_modules/@quartz-community/graph/dist/index.js" 2>/dev/null; then
    echo "daily: the graph loads its scripts from jsdelivr; run ~/.config/quartz-vault/setup.sh" >&2
    exit 1
  fi
  # custom.scss imports the palette tokens, which cozycabin-apply renders and
  # git does not hold.
  if [[ ! -f $tokens ]]; then
    echo "daily: the Quartz styles are missing $tokens; run cozycabin-apply --render" >&2
    exit 1
  fi
  echo "daily: starting the Quartz server (about 15 s)..." >&2
  mkdir -p "$(dirname "$log")"
  (cd "$quartz" && nohup npx quartz build --serve --port "$port" >"$log" 2>&1 &)
  for _ in $(seq 1 120); do server_up && break; sleep 0.5; done
  server_up || { echo "daily: the server did not start; see $log" >&2; exit 1; }
fi

# Keep the MR diffs under the working docs current. mr-diff exits at once when
# a watcher already runs, and the watcher stops after the server stops.
if command -v mr-diff >/dev/null; then
  mkdir -p "$(dirname "$log")"
  (nohup mr-diff --watch >>"$(dirname "$log")/mr-diff.log" 2>&1 &)
fi

if [[ -n $page ]]; then
  # A page by its path under the vault (absolute or relative), plus the
  # fragment after its first #, which the caller has percent-encoded.
  rel=${page%%#*}
  fragment=${page#"$rel"}
  rel=${rel#"$vault"/}
  rel=${rel#./}
  [[ -f $vault/$rel ]] || { echo "daily: no page at $vault/$rel" >&2; exit 1; }
  # Quartz's slug for a path: spaces to -, & to -and-, % to -percent, no ?#<>:"|*,
  # lowercase; .md dropped, .base kept.
  slug=$(sed -E 's/[[:space:]]/-/g; s/&/-and-/g; s/%/-percent/g; s/[?#<>:"|*]//g' <<<"${rel%.md}" | tr '[:upper:]' '[:lower:]')
  url="http://localhost:$port/$slug$fragment"
else
  shopt -s nullglob
  plans=("$vault"/weeklies/*/"$day"-daily-plan.md)
  if ((${#plans[@]} == 0)); then
    if $asked_day; then
      echo "daily: no plan for $day" >&2
      exit 1
    fi
    all=("$vault"/weeklies/*/*-daily-plan.md)
    ((${#all[@]})) || { echo "daily: no daily plans in $vault/weeklies" >&2; exit 1; }
    plans=("${all[${#all[@]} - 1]}")
    echo "daily: no plan for $day yet; opening $(basename "${plans[0]}" .md)" >&2
  fi
  rel=${plans[${#plans[@]} - 1]#"$vault"/}
  url="http://localhost:$port/${rel%.md}"
fi

if $print_only; then
  echo "$url"
  exit 0
fi

# In a cmux terminal outside herdr, the plan opens as a browser tab in this
# pane (the tree's `caller` names the pane); a second run moves the tab that
# already shows the site, in this pane first, else elsewhere in this
# workspace, and brings it to the front. The tree is unfiltered: a terminal
# tab moved to another workspace keeps its old CMUX_WORKSPACE_ID. Without a
# caller pane (a scrubbed environment, a tmux or zellij server, a stale
# CMUX_SURFACE_ID) a split beside this pane is still cmux. When cmux fails,
# terminal-browser takes over.
if [[ ${HERDR_ENV:-} != 1 && -n ${CMUX_WORKSPACE_ID:-} ]] && command -v cmux >/dev/null; then
  tree=$(cmux tree --all --json 2>/dev/null) || tree=""
  pane="" surface="" showing=""
  { read -r pane && read -r surface && read -r showing; } < <(jq -r --arg site "http://localhost:$port/" '
    .caller as $c
    | [.windows[]?.workspaces[]? | select(.ref == $c.workspace_ref) | .panes[]?.surfaces[]?
       | select(.type == "browser" and (.url // "" | startswith($site)))] as $tabs
    | (first(($tabs[] | select(.pane_ref == $c.pane_ref)), $tabs[]) // {}) as $tab
    | ($c.pane_ref // ""), ($tab.ref // ""), ($tab.url // "")
  ' <<<"$tree" 2>/dev/null) || true
  # A text fragment on the page the tab already shows is a same-document
  # navigation, which the browser does not scroll for; a query string makes it
  # a new load (Quartz ignores the query).
  if [[ -n ${fragment:-} && ${showing%%[#?]*} == "${url%%#*}" ]]; then
    url="${url%%#*}?open=$(date +%s)$fragment"
  fi
  if [[ -n $surface ]] && cmux browser --surface "$surface" goto "$url" >/dev/null 2>&1; then
    cmux focus-panel --panel "$surface" >/dev/null 2>&1 || true
    exit 0
  fi
  if [[ -n $pane ]] && out=$(cmux new-surface --type browser --pane "$pane" --url "$url" --focus true 2>/dev/null); then
    # `--focus true` focuses the pane but leaves the terminal tab selected
    # (cmux 0.65.2); focus-panel on the new surface ("OK surface:N ...") shows it.
    surface=$(sed -nE 's/^OK (surface:[^ ]+).*/\1/p' <<<"$out" | head -n 1)
    if [[ -z $surface ]] || ! cmux focus-panel --panel "$surface" >/dev/null 2>&1; then
      echo "daily: opened the plan as a tab in $pane but could not show it (${surface:-no surface ref in: $out})" >&2
    fi
    exit 0
  fi
  if [[ -z $pane ]]; then
    echo "daily: the cmux tree did not name this pane; opening a split instead" >&2
  else
    echo "daily: cmux did not open a tab in $pane; opening a split instead" >&2
  fi
  if cmux browser open "$url" --focus true >/dev/null 2>&1; then
    exit 0
  fi
  echo "daily: cmux did not open the plan; trying terminal-browser" >&2
fi
exec terminal-browser open "$url"
