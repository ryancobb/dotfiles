#######################################################################################################
# Exports
#######################################################################################################

typeset -U path manpath fpath infopath

export BAT_THEME="ansi"
export EDITOR="nvim"
export GOPATH="$HOME/go"
export HISTFILE="$HOME/.zsh_history"
export SAVEHIST=100000
export HISTSIZE=100000
export MANPAGER='nvim +Man!'
export MANWIDTH=999
export VISUAL="nvim"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

ZSH_CACHE="$XDG_CACHE_HOME/zsh"
mkdir -p "$ZSH_CACHE"


#######################################################################################################
# Homebrew
#######################################################################################################

if [[ -d /home/linuxbrew/.linuxbrew ]]; then # Linux
  export HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew"
  export HOMEBREW_CELLAR="$HOMEBREW_PREFIX/Cellar"
  export HOMEBREW_REPOSITORY="$HOMEBREW_PREFIX/Homebrew"
elif [[ -d /opt/homebrew ]]; then # MacOS
  export HOMEBREW_PREFIX="/opt/homebrew"
  export HOMEBREW_CELLAR="$HOMEBREW_PREFIX/Cellar"
  export HOMEBREW_REPOSITORY="$HOMEBREW_PREFIX/homebrew"
fi

if [[ -d "$HOMEBREW_PREFIX" ]]; then
  path=("$HOMEBREW_PREFIX/bin" "$HOMEBREW_PREFIX/sbin" $path)
  manpath+=("$HOMEBREW_PREFIX/share/man")
  infopath+=("$HOMEBREW_PREFIX/share/info")
  fpath+=("$HOMEBREW_PREFIX/share/zsh/site-functions")

  # brew version of git autocomplete is bad, remove it (re-run after brew upgrade)
  [[ -e "$HOMEBREW_PREFIX/share/zsh/site-functions/_git" ]] && command rm -f "$HOMEBREW_PREFIX/share/zsh/site-functions/_git"

  if [[ ! -f "$ZSH_CACHE/patina.zsh" ]] || [[ "$HOMEBREW_PREFIX/bin/zsh-patina" -nt "$ZSH_CACHE/patina.zsh" ]]; then
    "$HOMEBREW_PREFIX/bin/zsh-patina" activate > "$ZSH_CACHE/patina.zsh"
  fi
  source "$ZSH_CACHE/patina.zsh"
fi

path=("$HOME/.local/share/mise/shims" $path)
path=("$HOME/.local/bin" $path)

#######################################################################################################
# zcomet
#######################################################################################################

if [[ ! -f ${ZDOTDIR:-${HOME}}/.zcomet/bin/zcomet.zsh ]]; then
  command git clone https://github.com/agkozak/zcomet.git ${ZDOTDIR:-${HOME}}/.zcomet/bin
fi

source ${ZDOTDIR:-${HOME}}/.zcomet/bin/zcomet.zsh

# vi mode via zsh-vi-mode (ZVM). Its own key-reading engine gives instant Esc
# AND working multi-key sequences (text objects daw/yiw/ci", surround) — what
# native KEYTIMEOUT can't do at once. It also handles cursor shape itself.
# Leave ZVM_KEYTIMEOUT at default (0.4s) so text objects are typeable; instant
# Esc comes from the separate escape engine. INIT_MODE=sourcing + early load
# lets later plugins (fzf-tab, autosuggestions, fzf) bind on top of ZVM.
ZVM_INIT_MODE=sourcing
zcomet load jeffreytse/zsh-vi-mode

zcomet load zsh-users/zsh-completions

zcomet trigger ssh sunlei/zsh-ssh
zcomet load agkozak/zsh-z # eager, not triggered: installs its hook so dir tracking starts at shell launch

# completion config (before compinit)
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' menu no

# case-insensitive, partial-word, and substring matching
zstyle ':completion:*' matcher-list '' \
  'm:{a-zA-Z}={A-Za-z}' \
  'r:|[._-]=* r:|=*' \
  'l:|=* r:|=*'

# cache slow completions (brew, git, etc.)
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$ZSH_CACHE/zcompcache"

# Use cached .zcompdump without regenerating; after adding new completions run: rm -rf $ZSH_CACHE; exec zsh
zstyle ':zcomet:compinit' dump-file "$ZSH_CACHE/zcompdump"
zstyle ':zcomet:compinit' arguments -C
zcomet compinit

# fzf-tab must load AFTER compinit, but BEFORE widget-wrapping plugins (autosuggestions)
zcomet load Aloxaf/fzf-tab

# autosuggestions: suggest from history + completion, cap buffer for speed
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
zcomet load zsh-users/zsh-autosuggestions

# fzf-tab config (after compinit is fine)
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:*' switch-group '<' '>'

# more fzf-tab previews: git, env vars, process kill
zstyle ':fzf-tab:complete:git-(add|diff|restore|checkout):*' \
  fzf-preview '[[ -e $realpath ]] && (git diff --color=always -- $realpath 2>/dev/null || eza -1 --color=always $realpath)'
zstyle ':fzf-tab:complete:(-parameter-|export):*' \
  fzf-preview 'echo ${(P)word}'
zstyle ':fzf-tab:complete:(kill|ps):argument-rest' \
  fzf-preview '[[ $group == "[process ID]" ]] && ps -p $word -o command='

#######################################################################################################
# Aliases
#######################################################################################################

alias bx='bundle exec'
alias ll='eza -lbF --git'
alias icat="kitten icat"

# Git Aliases
alias gst='git status'
alias gl='git pull'
alias gf='git fetch'
alias gco='git checkout'
alias ggp='git push -u origin HEAD'

#######################################################################################################
# Functions
#######################################################################################################

gscrub() {
  local upstream
  if ! upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null); then
    echo "No upstream configured for the current branch." >&2
    return 1
  fi
  echo "This will hard-reset to $upstream and delete untracked files. Continue? (y/N)"
  if read -q; then
    echo
    git reset --hard '@{upstream}' && git clean -fd
  else
    echo "\nAborted."
  fi
}

portkill() {
  if [[ -z "$1" ]]; then
    echo "Usage: portkill <port>" >&2
    return 1
  fi
  local pids=$(lsof -t -i:"$1")
  if [[ -z "$pids" ]]; then
    echo "No process found on port $1" >&2
    return 1
  fi
  echo "$pids" | xargs kill -15 && echo "Sent SIGTERM to processes on port $1"
}

bcop() {
  local base="${1:-main}"
  if ! git rev-parse --verify --quiet "$base" >/dev/null; then
    echo "Not a valid ref: $base" >&2
    return 1
  fi
  local files=("${(@f)$(git diff --name-only --diff-filter=d "$base"...HEAD -- '*.rb')}")
  files=(${files:#})
  if (( ${#files} == 0 )); then
    echo "No changed .rb files against $base" >&2
    return 0
  fi
  bundle exec rubocop "${files[@]}"
}

brspec() {
  local base="${1:-main}"
  if ! git rev-parse --verify --quiet "$base" >/dev/null; then
    echo "Not a valid ref: $base" >&2
    return 1
  fi
  local files=("${(@f)$(git diff --name-only --diff-filter=d "$base"...HEAD -- '*_spec.rb')}")
  files=(${files:#})
  if (( ${#files} == 0 )); then
    echo "No changed spec files against $base" >&2
    return 0
  fi
  bundle exec rspec "${files[@]}"
}

#######################################################################################################
# Opts
#######################################################################################################

setopt share_history
setopt extended_history
setopt hist_ignore_all_dups
setopt hist_expire_dups_first
setopt hist_ignore_space
setopt hist_verify

setopt complete_in_word   # complete from cursor, not just end of word
setopt always_to_end      # move cursor to end after completion
setopt glob_complete      # tab on a glob expands to a completion menu

unsetopt nomatch # run rake task with args with no error
unsetopt BEEP

# Cache fzf init to avoid subprocess on every shell launch.
# NOTE: must stay AFTER `zcomet load Aloxaf/fzf-tab` above — fzf captures the
# current ^I binding (fzf-tab-complete) as its fallback for non-`**` TAB.
# Sourcing this before fzf-tab loads would silently disable fzf-tab.
if (( $+commands[fzf] )); then
  if [[ ! -f "$ZSH_CACHE/fzf.zsh" ]] || [[ $commands[fzf] -nt "$ZSH_CACHE/fzf.zsh" ]]; then
    fzf --zsh > "$ZSH_CACHE/fzf.zsh"
  fi
  source "$ZSH_CACHE/fzf.zsh"
fi

# Cache starship init to avoid subprocess on every shell launch
if (( $+commands[starship] )); then
  if [[ ! -f "$ZSH_CACHE/starship.zsh" ]] || [[ $commands[starship] -nt "$ZSH_CACHE/starship.zsh" ]]; then
    starship init zsh > "$ZSH_CACHE/starship.zsh"
  fi
  source "$ZSH_CACHE/starship.zsh"
fi
