set clipboard=unnamed

" Space is the leader, as in LazyVim. Vim mode has no <leader>, so the maps name <Space>.
unmap <Space>

exmap daily obcommand open-daily-plan:open-today
nmap <Space>fd :daily<CR>

exmap explorer obcommand app:toggle-left-sidebar
nmap <Space>e :explorer<CR>

" Move between panes, as <C-w>h/j/k/l. Pane Nav also reaches the sidebars, which editor:focus-* skips.
exmap focusleft obcommand pane-nav:focus-left
exmap focusdown obcommand pane-nav:focus-bottom
exmap focusup obcommand pane-nav:focus-top
exmap focusright obcommand pane-nav:focus-right
nmap <C-h> :focusleft<CR>
nmap <C-j> :focusdown<CR>
nmap <C-k> :focusup<CR>
nmap <C-l> :focusright<CR>
