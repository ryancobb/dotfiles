# Config for the Ghostty Terminal plugin in Obsidian (its "Config file path" setting). The plugin ignores
# `theme =`, so this file holds the colors of ~/.config/ghostty/themes/nordfox.ghostty, which
# ~/.config/ghostty/config uses. It reads palette 0 to 15 only. The padding around the terminal takes its color
# from snippets/ghostty-terminal.css; keep its background the same as the one here.

font-size = 13

background = #2e3440
foreground = #cdcecf
selection-background = #3e4a5b
selection-foreground = #cdcecf
cursor-color = #cdcecf
palette = 0=#3b4252
palette = 1=#bf616a
palette = 2=#a3be8c
palette = 3=#ebcb8b
palette = 4=#81a1c1
palette = 5=#b48ead
palette = 6=#88c0d0
palette = 7=#e5e9f0
palette = 8=#465780
palette = 9=#d06f79
palette = 10=#b1d196
palette = 11=#f0d399
palette = 12=#8cafd2
palette = 13=#c895bf
palette = 14=#93ccdc
palette = 15=#e7ecf4
